{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://donkeyspace.dev/schemas/run-result.codex-developer.schema.json",
  "title": "donkeyspace codex developer run result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outcome",
    "summary",
    "confidence",
    "risk",
    "questions",
    "tests",
    "changed_files",
    "human_review_reason",
    "blocked_reason"
  ],
  "properties": {
    "outcome": {
      "type": "string",
      "enum": [
        "implemented",
        "needs_info",
        "needs_human",
        "blocked",
        "failed"
      ]
    },
    "summary": {
      "type": "string"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "unknown"
      ]
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "command",
          "status",
          "exit_code",
          "summary"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "skipped",
              "not_run"
            ]
          },
          "exit_code": {
            "type": "integer"
          },
          "summary": {
            "type": "string"
          }
        }
      }
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "human_review_reason": {
      "type": "string"
    },
    "blocked_reason": {
      "type": "string"
    }
  }
}
