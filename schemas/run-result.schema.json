{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://donkeyspace.dev/schemas/run-result.schema.json",
  "title": "donkeyspace agent run result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outcome",
    "summary",
    "confidence",
    "risk",
    "questions",
    "tests",
    "changed_files",
    "human_review_reason",
    "blocked_reason"
  ],
  "properties": {
    "outcome": {
      "type": "string",
      "enum": [
        "ready",
        "needs_info",
        "implemented",
        "reviewed",
        "needs_changes",
        "needs_human",
        "blocked",
        "failed"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "unknown"
      ]
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "command",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "skipped",
              "not_run"
            ]
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "summary": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "human_review_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "blocked_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "resources_used": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "work_items": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "handoff": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "target",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "needs_info"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "questions": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "needs_human"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "human_review_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "enum": [
              "blocked",
              "failed"
            ]
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "blocked_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "implemented"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "tests": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
