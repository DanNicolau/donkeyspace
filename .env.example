# Copy this file to .env before running docker compose.
# Do not commit .env; it may contain GitHub and model-provider secrets.

# API service.
DONKEYSPACE_BIND_ADDR=0.0.0.0:8080
DONKEYSPACE_DATABASE_URL=postgres://donkeyspace:donkeyspace@postgres:5432/donkeyspace
DONKEYSPACE_POLICY_PATH=.donkeyspace/policy.yml
RUST_LOG=donkeyspace=info,tower_http=info

# Dashboard dev server API proxy target.
# Use http://api:8080 inside docker compose, or http://localhost:8080 locally.
DONKEYSPACE_API_PROXY_TARGET=http://localhost:8080

# Required for GitHub webhook signature verification.
# Use the same value in the GitHub webhook configuration.
DONKEYSPACE_WEBHOOK_SECRET=

# Required for private repository checkout, branch pushes, PR creation,
# creating missing donkeyspace labels, and applying pending GitHub labels/comments.
DONKEYSPACE_GITHUB_TOKEN=

# Optional webhook-free GitHub ingestion. Comma-separate owner/repository names.
# The API polls GitHub's repository event feed and uses event IDs for deduplication.
DONKEYSPACE_GITHUB_POLL_REPOSITORIES=
DONKEYSPACE_GITHUB_POLL_INTERVAL_SECONDS=60
DONKEYSPACE_GITHUB_POLL_MAX_PAGES=2

# Worker identity and lease behavior.
DONKEYSPACE_WORKER_ID=worker-local
DONKEYSPACE_LEASE_SECONDS=300

# agent runs the configured Codex CLI wrappers.
# auto uses the OpenAI-compatible endpoint when a key is configured.
DONKEYSPACE_TRIAGE_PROVIDER=agent

# Optional OpenAI-compatible triage settings for DONKEYSPACE_TRIAGE_PROVIDER=auto.
DONKEYSPACE_LLM_BASE_URL=https://openrouter.ai/api/v1
DONKEYSPACE_LLM_MODEL=openrouter/free
DONKEYSPACE_LLM_API_KEY=
OPENROUTER_API_KEY=

# Worker workspace and context tuning.
DONKEYSPACE_WORKSPACE_ROOT=/workspaces
DONKEYSPACE_WORKSPACE_VOLUME=donkeyspace-workspaces
DONKEYSPACE_CODEX_VOLUME=donkeyspace-codex-home
# Parent directory containing installed plugin repositories. Individual plugins
# own any additional mounts and runtime variables through Compose overlays.
DONKEYSPACE_PLUGINS_DIR=../plugins
DONKEYSPACE_REPO_CONTEXT_MAX_BYTES=20000
DONKEYSPACE_REPO_CONTEXT_MAX_FILE_BYTES=4000
DONKEYSPACE_REPO_CONTEXT_MAX_FILES=12

# Reconciliation limits per worker poll.
DONKEYSPACE_READY_RECONCILE_LIMIT=1
DONKEYSPACE_REPAIR_RECONCILE_LIMIT=1
